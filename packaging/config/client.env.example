# /etc/cslvpn/client.env - configuration of the CSLVPN client
# (read by cslvpn-client.service).

# Address of the relay (host:port). Required.
CSLVPN_SERVER=203.0.113.10:7777

# Network (room) name and password.
CSLVPN_NETWORK=office
CSLVPN_PASSWORD=change-me

# Transport: udp (low latency) or tcp (passes restrictive firewalls).
CSLVPN_TRANSPORT=tcp

# Name shown to other members and the TUN interface name.
CSLVPN_MEMBER=my-laptop
CSLVPN_IFACE=cslvpn0
