# /etc/cslvpn/server.env - configuration of the CSLVPN relay (read by
# cslvpn.service). Uncomment and adjust what you need.

# Address for both the UDP and the TCP listener (one port serves both).
CSLVPN_LISTEN=:7777

# Admin HTTP API. Bind it to localhost and put it behind a reverse proxy if you
# need remote access. Set CSLVPN_ADMIN_TOKEN to require a bearer token.
CSLVPN_ADMIN=127.0.0.1:7778
#CSLVPN_ADMIN_TOKEN=change-me

# Limits (defaults shown).
#CSLVPN_MAX_MEMBERS=150
#CSLVPN_MAX_NETWORKS=4096
#CSLVPN_ALLOW_CREATE=true

# Internet gateway mode: uncomment both lines, create the TUN device first
# (see docs/SERVER.md section 5) and override User=root in a systemd drop-in.
#CSLVPN_GATEWAY=-gateway -gateway-iface cslgw -nat-cidr 26.0.0.0/8
