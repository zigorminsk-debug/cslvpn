# /etc/cslvpn/server.env - configuration of the CSLVPN relay
# (read by cslvpn.service). Uncomment and adjust what you need.
#
# Only the variables below are wired into the unit's ExecStart. Anything else
# (limits, timeouts, gateway mode) is a command-line flag: override ExecStart
# in a drop-in, e.g. /etc/systemd/system/cslvpn.service.d/limits.conf:
#
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/cslvpn server -listen :7777 -admin 127.0.0.1:7778 \
#       -max-members 150 -max-networks 4096 -idle-network 24h -ban 15m

# Address for both the UDP and the TCP listener (one port serves both).
CSLVPN_LISTEN=:7777

# Admin HTTP API. Bind it to localhost and put it behind a reverse proxy if you
# need remote access. Set CSLVPN_ADMIN_TOKEN to require a bearer token - the
# binary reads it directly from the environment.
CSLVPN_ADMIN=127.0.0.1:7778
#CSLVPN_ADMIN_TOKEN=change-me

# Internet gateway mode is a drop-in too (the unit runs as DynamicUser, while
# TUN + iptables need root):
#
#   [Service]
#   User=root
#   DynamicUser=no
#   AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW
#   ExecStart=
#   ExecStart=/usr/bin/cslvpn server -listen :7777 -admin 127.0.0.1:7778 \
#       -gateway -gateway-iface cslgw -nat-cidr 26.0.0.0/8
#
# Create the cslgw device first, see docs/DEPLOYMENT.md section 9.
